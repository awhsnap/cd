# Copy to .env for local development (`make dev` loads it). Never commit .env.

APP_ENV=development
DB_PATH=data/app.db
PUBLIC_ADDR=:8080
ADMIN_ADDR=127.0.0.1:9090
BASE_URL=http://localhost:8080

# Required in production: 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Keep a copy in your password manager — without it, encrypted notes and
# messages in backups cannot be read.
MASTER_KEY=

# Texting (leave blank to log messages instead of sending)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email (leave blank to log instead of sending)
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=Calendar Dynamics <no-reply@localhost>

# Demo seed (optional)
DEMO_EMAIL=demo@calendardynamics.test
DEMO_PASSWORD=
